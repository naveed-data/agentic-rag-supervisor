# OpenAI (required)
OPENAI_API_KEY=""

# GitHub (optional - raises the GitHub API rate limit for the 'github' tool)
GITHUB_TOKEN=""

# Langfuse (optional - tracing/observability is skipped if unset)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Postgres (optional - 'scientist_db' tool is skipped if the database isn't reachable)
DATABASE_URL="postgresql://localhost:5432/ragdemo"
